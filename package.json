{
  "name": "global-market-terminal-windows",
  "productName": "GLOBAL MARKET TERMINAL",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows 11 x64 read-only analysis terminal \u2014 Phase 1 offline foundation",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:packaged": "node scripts/smoke.mjs --packaged",
    "test:frozen": "node scripts/frozen-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.60.0",
    "lightweight-charts": "5.2.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "esbuild": "0.28.2",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1"
  },
  "author": {
    "name": "Nirdesh Balar",
    "url": "https://github.com/nirdesh-balar"
  }
}
